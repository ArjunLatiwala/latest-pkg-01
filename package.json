{
  "name": "cs-setup",
  "version": "1.1.3",
  "description": "Automatic Husky + Gitleaks + SonarQube setup for any JS/TS project",
  "main": "bin/index.js",
  "bin": {
    "cs-setup": "./bin/index.js"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "scripts/"
  ],
  "scripts": {
    "postinstall": "node ./bin/index.js install",
    "prepare": "node scripts/prepare.js || true",
    "test": "node --test"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "execa": "^5.1.1",
    "fs-extra": "^11.3.3",
    "husky": "^9.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "sonarqube-scanner": "^4.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArjunLatiwala/latest-pkg-01.git"
  }
}
